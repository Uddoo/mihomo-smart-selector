#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

PROG=/opt/mihomo-smart-selector/mihomo-smart-selector
CONFIG=/etc/mihomo-smart-selector/config.yaml
ACCESS_TOKEN_FILE=/etc/mihomo-smart-selector/access-token

start_service() {
    [ -x "$PROG" ] || return 1
    [ -r "$CONFIG" ] || return 1

    if [ ! -s "$ACCESS_TOKEN_FILE" ]; then
        umask 077
        token="$(dd if=/dev/urandom bs=32 count=1 2>/dev/null | hexdump -v -e '/1 "%02x"')"
        [ -n "$token" ] || return 1
        printf '%s\n' "$token" > "$ACCESS_TOKEN_FILE"
        unset token
    fi
    chmod 0600 "$ACCESS_TOKEN_FILE" || return 1

    # The application reads mihomo.secret_file from its configuration.
    # No subscription filename or YAML parsing is assumed by this service.
    api_token="$(cat "$ACCESS_TOKEN_FILE")"
    [ -n "$api_token" ] || return 1

    procd_open_instance
    procd_set_param command "$PROG" -config "$CONFIG"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param nice 10
    # Router defaults: one Go execution core and a soft managed-memory budget.
    # GOMEMLIMIT is not an RSS/cgroup hard cap; validate real device consumption.
    procd_set_param env "MSS_API_TOKEN=$api_token" "GOMAXPROCS=1" "GOMEMLIMIT=128MiB"
    procd_close_instance

    unset api_token
}

stop_service() {
    return 0
}
