#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

PROG=/opt/mihomo-smart-selector/mihomo-smart-selector
CONFIG=/etc/mihomo-smart-selector/config.yaml
SECRET_SOURCE=/etc/openclash/dukou.yaml
ACCESS_TOKEN_FILE=/etc/mihomo-smart-selector/access-token

start_service() {
    [ -x "$PROG" ] || return 1
    [ -r "$CONFIG" ] || return 1
    [ -r "$SECRET_SOURCE" ] || return 1

    if [ ! -s "$ACCESS_TOKEN_FILE" ]; then
        umask 077
        token="$(dd if=/dev/urandom bs=32 count=1 2>/dev/null | hexdump -v -e '/1 "%02x"')"
        [ -n "$token" ] || return 1
        printf '%s\n' "$token" > "$ACCESS_TOKEN_FILE"
        unset token
    fi
    chmod 0600 "$ACCESS_TOKEN_FILE" || return 1

    # Keep the Controller secret in OpenClash-managed storage. It is read only
    # into this process environment and is neither copied to selector config
    # nor written to logs.
    secret="$(sed -n -E 's/^[[:space:]]*secret:[[:space:]]*//p' "$SECRET_SOURCE" | head -n 1 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^"//;s/"$//')"
    api_token="$(cat "$ACCESS_TOKEN_FILE")"
    [ -n "$secret" ] || return 1
    [ -n "$api_token" ] || return 1

    procd_open_instance
    procd_set_param command "$PROG" -config "$CONFIG"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param env "MIHOMO_SECRET=$secret" "MSS_API_TOKEN=$api_token"
    procd_close_instance

    unset secret
    unset api_token
}

stop_service() {
    return 0
}
