{
  "name": "mihomo-smart-selector-web",
  "private": true,
  "version": "0.6.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "test": "node build/test.mjs",
    "test:e2e": "pnpm build && playwright test",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{vue,ts,css,mjs}\" \"build/*.mjs\" vite.config.ts",
    "format:check": "prettier --check \"src/**/*.{vue,ts,css,mjs}\" \"build/*.mjs\" vite.config.ts"
  },
  "dependencies": {
    "@lucide/vue": "^1.57.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "fflate": "0.8.3",
    "prettier": "3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
